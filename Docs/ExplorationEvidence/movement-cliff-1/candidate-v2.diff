+    internal static class ExplorationSlideSampling
+    {
+        // A three-point one-sided stencil fits within half of one10cm cell.
+        // Select the smoother side so a remote step cannot tilt a flat support.
+        // Quadratic smooth ramps retain their exact local derivative.
+        public static bool TryGradient(IWorldField field,double x,double z,out double gx,out double gz)
+        {
+            double p=WorldCell.SizeMeters*.25,h=field.Sample(x,z).HeightMeters;
+            gx=Axis(h,field.Sample(x-p,z).HeightMeters,field.Sample(x-2*p,z).HeightMeters,
+                field.Sample(x+p,z).HeightMeters,field.Sample(x+2*p,z).HeightMeters,p);
+            gz=Axis(h,field.Sample(x,z-p).HeightMeters,field.Sample(x,z-2*p).HeightMeters,
+                field.Sample(x,z+p).HeightMeters,field.Sample(x,z+2*p).HeightMeters,p);
+            return !double.IsNaN(gx)&&!double.IsInfinity(gx)&&!double.IsNaN(gz)&&!double.IsInfinity(gz);
+        }
+        static double Axis(double h,double m,double mm,double p,double pp,double spacing)
+        {
+            double backward=(3*h-4*m+mm)/(2*spacing),forward=(-3*h+4*p-pp)/(2*spacing);
+            double left=Math.Abs(h-2*m+mm),right=Math.Abs(h-2*p+pp);
+            return left<right?backward:right<left?forward:(backward+forward)*.5;
+        }
+    }
